+    /// Bastion patch: the parallel region path must give exactly what decoding tile by tile
+    /// gives — pixels and the reference coefficients later difference tiles build on.
+    #[test]
+    fn parallel_region_decode_matches_sequential() {
+        use ironrdp_pdu::codecs::rfx::progressive::{ProgressiveTile, TileFirst};
+
+        let (w, h) = (4u16, 3u16);
+        let quant = ComponentCodecQuant { ll3: 6, hl3: 6, lh3: 6, hh3: 6, hl2: 7, lh2: 7, hh2: 8, hl1: 8, lh1: 8, hh1: 9 };
+        let mut data = Vec::new();
+        for ty in 0..h {
+            for tx in 0..w {
+                let mut rgba = vec![0u8; 64 * 64 * 4];
+                for (i, px) in rgba.chunks_exact_mut(4).enumerate() {
+                    let v = (i as u32 * (u32::from(tx) + 3) + u32::from(ty) * 977) as u8;
+                    px.copy_from_slice(&[v, v.wrapping_mul(3), v ^ 0x5a, 255]);
+                }
+                let (mut y, mut cb, mut cr) = ([0i16; 4096], [0i16; 4096], [0i16; 4096]);
+                rgba_to_ycbcr(&rgba, &mut y, &mut cb, &mut cr);
+                let enc = |c: &mut [i16]| {
+                    let mut out = vec![0u8; 64 * 64 * 4];
+                    let n = encode_first_pass(c, &mut out, &quant, &ComponentCodecQuant::LOSSLESS, false).unwrap();
+                    out.truncate(n);
+                    out
+                };
+                data.push((tx, ty, [enc(&mut y), enc(&mut cb), enc(&mut cr)]));
+            }
+        }
+        assert!(data.len() >= PARALLEL_MIN_TILES, "must exercise the parallel path");
+        let tiles = |flags: u8| -> Vec<ProgressiveTile<'_>> {
