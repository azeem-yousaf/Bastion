+        let error = decode(&mut decoder, 1, 1024, &tiles(1, 8, 8));
+        assert!(matches!(error, Err(ProgressiveDecodeError::TileBudgetExceeded)), "parallel");
+        assert_eq!((decoder.live_tiles(), decoder.references.len()), (20, 20));
+        assert_eq!(decoder.surfaces[&1].live_tiles(), 20);
+        assert!(decoder.surfaces[&1].tiles[16 + 8..].iter().all(Option::is_none));
+        // At the cap, existing tiles still decode (both paths).
+        decode(&mut decoder, 1, 1024, &tiles(0, 0, 12)).unwrap();
+        decode(&mut decoder, 1, 1024, &tiles(1, 0, 3)).unwrap();
