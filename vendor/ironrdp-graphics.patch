+        decode(&mut decoder, 1, 1024, &tiles(1, 0, 6)).unwrap();
+        assert_eq!((decoder.live_tiles(), decoder.references.len()), (18, 18));
+        // Decoding tiles that already have state costs nothing more.
+        decode(&mut decoder, 1, 1024, &tiles(0, 0, 12)).unwrap();
+        assert_eq!(decoder.live_tiles(), 18);
