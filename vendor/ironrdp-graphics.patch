+                .map(|(x_idx, y_idx, d)| {
+                    ProgressiveTile::First(TileFirst {
+                        quant_idx_y: 0,
+                        quant_idx_cb: 0,
+                        quant_idx_cr: 0,
+                        x_idx: *x_idx,
+                        y_idx: *y_idx,
+                        flags,
+                        quality: 0,
+                        y_data: &d[0],
+                        cb_data: &d[1],
+                        cr_data: &d[2],
+                        tail_data: &[],
+                    })
+                })
+                .collect()
+        };
+        let quant_vals = [quant];
+        let lossless = ComponentCodecQuant::LOSSLESS;
+        let prog = [ProgressiveCodecQuant { quality: 0, y_quant: lossless, cb_quant: lossless, cr_quant: lossless }];
+        let run = |parallel: bool| {
+            let mut surface = SurfaceTiles::new(w * 64, h * 64, false).unwrap();
+            let mut refs = BTreeMap::new();
+            let mut budget = TileBudget {
+                live: 0,
+                max: MAX_LIVE_TILES,
+            };
