+    /// Bastion patch: a stream of REGION blocks over a 64x64-tile grid, one tile block per
+    /// `(x, y, upgrade)` entry (TILE_SIMPLE with empty components, or an empty TILE_UPGRADE).
+    fn tile_grid_stream(tiles: &[(u16, u16, bool)]) -> Vec<u8> {
+        use ironrdp_pdu::codecs::rfx::RfxRectangle;
+        use ironrdp_pdu::codecs::rfx::progressive::{
+            ProgressiveBlock, ProgressiveContextPdu, ProgressiveFrameBeginPdu, ProgressiveFrameEndPdu,
+            ProgressiveRegion, ProgressiveSyncPdu, ProgressiveTile, TileSimple, TileUpgrade,
+            encode_progressive_stream,
+        };
+
+        let lossless = ComponentCodecQuant::LOSSLESS;
+        let component = encode_full_quality_component(1);
+        let tiles = tiles
+            .iter()
+            .map(|&(x_idx, y_idx, upgrade)| {
+                if upgrade {
+                    ProgressiveTile::Upgrade(TileUpgrade {
+                        quant_idx_y: 0,
+                        quant_idx_cb: 0,
+                        quant_idx_cr: 0,
+                        x_idx,
+                        y_idx,
+                        quality: 0,
+                        y_srl_data: &[],
+                        y_raw_data: &[],
+                        cb_srl_data: &[],
+                        cb_raw_data: &[],
+                        cr_srl_data: &[],
+                        cr_raw_data: &[],
+                    })
+                } else {
+                    ProgressiveTile::Simple(TileSimple {
+                        quant_idx_y: 0,
+                        quant_idx_cb: 0,
+                        quant_idx_cr: 0,
+                        x_idx,
+                        y_idx,
+                        flags: 0,
+                        y_data: &component,
+                        cb_data: &component,
+                        cr_data: &component,
+                        tail_data: &[],
+                    })
+                }
+            })
+            .collect();
+        let blocks = [
+            ProgressiveBlock::Sync(ProgressiveSyncPdu),
+            ProgressiveBlock::Context(ProgressiveContextPdu {
+                context_id: 0,
+                tile_size: 0x0040,
+                flags: 0,
+            }),
+            ProgressiveBlock::FrameBegin(ProgressiveFrameBeginPdu {
+                frame_index: 0,
+                region_count: 1,
+            }),
+            ProgressiveBlock::Region(ProgressiveRegion {
+                tile_size: 0x40,
+                rects: vec![RfxRectangle {
+                    x: 0,
+                    y: 0,
+                    width: 64,
+                    height: 64,
+                }],
+                quant_vals: vec![lossless],
+                quant_prog_vals: vec![ProgressiveCodecQuant {
+                    quality: 0,
+                    y_quant: lossless,
+                    cb_quant: lossless,
+                    cr_quant: lossless,
+                }],
+                flags: 0,
+                tiles,
+            }),
+            ProgressiveBlock::FrameEnd(ProgressiveFrameEndPdu),
+        ];
+        encode_progressive_stream(&blocks).expect("synthetic progressive stream should encode")
+    }
