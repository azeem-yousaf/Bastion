+    /// Bastion patch: blitting AVC420 regions straight from the decoded frame (when the
+    /// handler opts out of pixel data) must leave the surface exactly as the copy path does,
+    /// for region updates and for the no-region fallback.
+    #[test]
+    fn avc420_direct_blit_matches_copy_path() {
+        const SURFACE: u16 = 100;
+        struct NoData;
+        impl GraphicsPipelineHandler for NoData {
+            fn wants_bitmap_data(&self) -> bool {
+                false
+            }
+        }
+        let rect = |left, top, right, bottom| ExclusiveRectangle { left, top, right, bottom };
+        let run = |handler: Box<dyn GraphicsPipelineHandler>| -> Vec<u8> {
+            let mut client =
+                GraphicsPipelineClient::new(handler, Some(Box::new(CoordinateDecoder { width: 64, height: 64 })));
+            client
+                .handle_pdu(GfxPdu::CreateSurface(crate::pdu::CreateSurfacePdu {
+                    surface_id: SURFACE,
+                    width: SURFACE,
+                    height: SURFACE,
+                    pixel_format: PixelFormat::XRgb,
+                }))
+                .expect("create surface");
+            for (dest, regions) in [
+                (rect(0, 0, 48, 48), vec![rect(0, 0, 16, 16), rect(32, 32, 48, 48)]),
+                (rect(50, 60, 90, 90), vec![]),
+                (rect(0, 0, 64, 64), vec![rect(5, 7, 61, 33)]),
+            ] {
+                client
+                    .handle_pdu(GfxPdu::WireToSurface1(crate::pdu::WireToSurface1Pdu {
+                        surface_id: SURFACE,
+                        codec_id: Codec1Type::Avc420,
+                        pixel_format: PixelFormat::XRgb,
+                        destination_rectangle: dest,
+                        bitmap_data: encode_avc420_wire(&regions),
+                    }))
+                    .expect("decode avc420");
+            }
+            client.compositor.surface_pixels(SURFACE).expect("surface").to_vec()
+        };
+        let with_copy = run(Box::new(TestHandler));
+        let direct = run(Box::new(NoData));
+        assert!(with_copy.iter().any(|&b| b != 0), "something was drawn");
+        assert!(with_copy == direct, "direct blit differs from the copy path");
+    }
