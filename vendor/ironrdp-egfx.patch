+
+    /// Bastion patch: like [`Self::apply_bitmap`], but reads the `dest`-sized block at
+    /// `source` (x, y) of a larger RGBA8888 buffer with `src_stride` bytes per row, so a
+    /// decoded frame can be blitted without first copying the region out of it.
+    pub(crate) fn apply_bitmap_from(
+        &mut self,
+        surface_id: u16,
+        dest: &ExclusiveRectangle,
+        src: &[u8],
+        src_stride: usize,
+        source: (u16, u16),
+    ) {
+        let x = dest.left;
+        let y = dest.top;
+        let w = dest.right.saturating_sub(dest.left);
+        let h = dest.bottom.saturating_sub(dest.top);
+        if let Some(surface) = self.surfaces.get_mut(&surface_id) {
+            let offset = usize::from(source.1)
+                .saturating_mul(src_stride)
+                .saturating_add(usize::from(source.0) * BYTES_PER_PIXEL);
+            let src = src.get(offset..).unwrap_or(&[]);
+            if surface.has_alpha && surface.window.is_some() {
+                // Rare (window-mapped surfaces): reuse the tight-buffer path.
+                let mut tight = Vec::with_capacity(usize::from(w) * usize::from(h) * BYTES_PER_PIXEL);
+                for row in 0..usize::from(h) {
+                    let start = row * src_stride;
+                    let end = start + usize::from(w) * BYTES_PER_PIXEL;
+                    tight.extend_from_slice(src.get(start..end).unwrap_or(&[]));
+                }
+                blit_color_region(surface.canvas_mut(), x, y, w, h, &tight);
+            } else {
+                blit_region_strided(surface.canvas_mut(), x, y, w, h, src, src_stride);
+            }
+        }
+        self.record_dirty(surface_id, x, y, w, h);
+    }
