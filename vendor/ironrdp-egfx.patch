+    /// A surface's RGBA pixels (tests).
+    #[cfg(test)]
+    pub(crate) fn surface_pixels(&self, surface_id: u16) -> Option<&[u8]> {
+        self.surfaces.get(&surface_id).map(|s| s.data.as_slice())
